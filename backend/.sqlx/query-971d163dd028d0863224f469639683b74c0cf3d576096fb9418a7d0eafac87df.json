{
  "db_name": "PostgreSQL",
  "query": "SELECT \n        c.id, \n        c.name, \n        g.id AS \"grantedById!\", \n        g.name AS \"grantedByName!\", \n        b.id AS \"badge_id\", \n        b.name AS \"badge_name\", \n        grantedat \n      FROM \n        badge_assignment \n        JOIN \"character\" AS c ON characterId = c.id \n        JOIN \"character\" AS g ON grantedById = g.id \n        JOIN badge AS b ON badgeId = b.id \n      WHERE \n        badgeId = $1",
