[Unit]
Description=EVE Online Fleet Waitlist Server
After=network.target nss-lookup.target

[Service]
Type=simple
DynamicUser=true
ExecStart=/home/wwwroot/waitlist/backend/target/release/tdf_wl
WorkingDirectory=/home/wwwroot/waitlist/backend
EnvironmentFile=/home/wwwroot/waitlist/backend/.env

[Install]
WantedBy=multi-user.target
